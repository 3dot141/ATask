// Settings shared by Debug and Release. Version.xcconfig is written by scripts/generate.sh from
// version.properties at the repository root (the version of both apps).
#include? "Version.xcconfig"

ATASK_BUNDLE_ID_BASE = com.yes365.atask
ATASK_APP_GROUP_BASE = group.com.yes365.atask

// Local.xcconfig (not checked in) holds the signing team for builds on a device, so it survives
// regenerating the project: DEVELOPMENT_TEAM = <your team id>. CI passes the team on the command line.
#include? "Local.xcconfig"
